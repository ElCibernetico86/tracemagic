rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /traces/{traceId} {
      // Users can only read and write their own traces
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      // Allow create if the userId matches their auth uid
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
    match /shared_traces/{traceId} {
      // Anyone can read shared traces
      allow read: if true;
      // Anyone can create shared traces
      allow create: if true;
      // No updates or deletes allowed for shared traces
      allow update, delete: if false;
    }
  }
}
