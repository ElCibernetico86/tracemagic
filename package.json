    "express": "^4.21.2",
    "firebase": "^12.15.0",
    "fit-curve": "^0.2.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.41.0",
    "multer": "^2.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-firebase-hooks": "^5.1.1",
    "react-router": "^8.0.1",
